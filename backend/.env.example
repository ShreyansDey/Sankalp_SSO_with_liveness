# Database connection (SQLite default for quick start, PostgreSQL for production)
DATABASE_URL=sqlite:///./sankalp.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/sankalp

# JWT & Session Security
JWT_SECRET=sankalp-dev-super-secret-key-change-in-production-must-be-long-and-random-32bytes
ACCESS_TOKEN_MINUTES=10
SSO_SESSION_HOURS=8
INACTIVITY_DAYS=60

# Allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5180
APP_A_ORIGIN=http://localhost:5174
APP_B_ORIGIN=http://localhost:5175
