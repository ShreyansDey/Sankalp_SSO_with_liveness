# ==============================================================================
# SANKALP SSO & DIGITAL IDENTITY — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your production server:
#     cp .env.production.example .env
# Never commit the populated .env file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode Flags
# ------------------------------------------------------------------------------
ENVIRONMENT=production
# Set BOOTSTRAP_PROD=true on the very first start to initialize the real admin
# and products without any demo users. Once initialized, set to false.
BOOTSTRAP_PROD=true
ENABLE_SCHEDULER=true

# ------------------------------------------------------------------------------
# 2. Production PostgreSQL Database (Replaces local SQLite)
# ------------------------------------------------------------------------------
POSTGRES_USER=sankalp_user
POSTGRES_PASSWORD=REPLACE_WITH_VERY_STRONG_DATABASE_PASSWORD
POSTGRES_DB=sankalp_production
DATABASE_URL=postgresql://sankalp_user:REPLACE_WITH_VERY_STRONG_DATABASE_PASSWORD@db:5432/sankalp_production

# ------------------------------------------------------------------------------
# 3. Cryptographic Token & Session Security
# Generate a fresh 64-character hex key:
#     openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_MINUTES=10
SSO_SESSION_HOURS=8
INACTIVITY_DAYS=60
PURGE_GRACE_HOURS=48

# ------------------------------------------------------------------------------
# 4. Domain Names & Allowed CORS Origins (Replace with your server domains/IP)
# In production, use HTTPS URLs everywhere.
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=https://sso.youruniversity.edu
APP_A_ORIGIN=https://photo.youruniversity.edu
APP_B_ORIGIN=https://robotics.youruniversity.edu

# ------------------------------------------------------------------------------
# 5. Real Administrator Account (NO DEMO USERS)
# This account will be created with active status and full admin privileges.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@youruniversity.edu
ADMIN_NAME=Chief Information Security Officer
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# ------------------------------------------------------------------------------
# 6. Real SMTP Server (For Password Resets & 48h Recovery Notices)
# Compatible with Google Workspace, Microsoft 365, Amazon SES, or local Postfix.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sso-notifications@youruniversity.edu
SMTP_PASS=your-secure-app-password
SMTP_SECURE=tls
EMAIL_FROM=sso-notifications@youruniversity.edu
EMAIL_FROM_NAME=Real Access (Sankalp SSO)

# ------------------------------------------------------------------------------
# 7. Connected Products Client Secrets (Optional: auto-generated if omitted)
# ------------------------------------------------------------------------------
APP_A_CLIENT_SECRET=
APP_B_CLIENT_SECRET=
APP_C_CLIENT_SECRET=
APP_D_CLIENT_SECRET=
APP_E_CLIENT_SECRET=
